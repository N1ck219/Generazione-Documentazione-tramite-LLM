          "rb_is_empty"
        ],
        "line": 49,
        "raw_comment": null,
        "source_code": "rb_status_t rb_pop(RingBuffer *rb, int *out_value) {\n    if (rb == NULL || rb->data == NULL || out_value == NULL) {\n        return RB_ERR_NULL_PTR;\n    }\n\n    if (rb_is_empty(rb)) {\n        return RB_ERR_EMPTY;\n    }\n\n    *out_value = rb->data[rb->tail];\n    rb->tail = (rb->tail + 1) % rb->capacity;\n    rb->count--;\n\n    return RB_OK;\n}\n",
        "time_complexity": "O(1)",
        "space_complexity": "O(1) (spazio ausiliario)"
      },
