        "line": 22,
        "raw_comment": null,
        "source_code": "void rb_free(RingBuffer *rb) {\n    if (rb != NULL && rb->data != NULL) {\n        free(rb->data);\n        rb->data = NULL;\n        rb->capacity = 0;\n        rb->head = 0;\n        rb->tail = 0;\n        rb->count = 0;\n    }\n}\n",
        "time_complexity": "O(1)",
        "space_complexity": "O(1) (spazio ausiliario)"
      },
