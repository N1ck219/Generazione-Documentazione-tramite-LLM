        "line": 33,
        "raw_comment": null,
        "source_code": "rb_status_t rb_push(RingBuffer *rb, int value) {\n    if (rb == NULL || rb->data == NULL) {\n        return RB_ERR_NULL_PTR;\n    }\n\n    if (rb_is_full(rb)) {\n        return RB_ERR_FULL;\n    }\n\n    rb->data[rb->head] = value;\n    rb->head = (rb->head + 1) % rb->capacity;\n    rb->count++;\n\n    return RB_OK;\n}\n",
        "time_complexity": "O(1)",
        "space_complexity": "O(1) (spazio ausiliario)"
      },
