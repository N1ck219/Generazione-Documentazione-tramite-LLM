        "line": 4,
        "raw_comment": null,
        "source_code": "rb_status_t rb_init(RingBuffer *rb, size_t capacity) {\n    if (rb == NULL || capacity == 0) {\n        return RB_ERR_NULL_PTR;\n    }\n\n    rb->data = (int *)malloc(capacity * sizeof(int));\n    if (rb->data == NULL) {\n        return RB_ERR_NO_MEM;\n    }\n\n    rb->capacity = capacity;\n    rb->head = 0;\n    rb->tail = 0;\n    rb->count = 0;\n\n    return RB_OK;\n}\n",
        "time_complexity": "O(1)",
        "space_complexity": "O(N) (allocazione/copia dinamica)"
      },
