	url = {https://www.sciencedirect.com/science/article/pii/0047259X8290077X},
	doi = {10.1016/0047-259X(82)90077-X},
	abstract = {The Fréchet distance between two multivariate normal distributions having means μX, μY and covariance matrices ΣX, ΣY is shown to be given by d2 = {\textbar}μX − μY{\textbar}2 + tr(ΣX + ΣY − 2(ΣXΣY)12). The quantity d0 given by d02 = tr(ΣX + ΣY − 2(ΣXΣY)12) is a natural metric on the space of real covariance matrices of given order.},
