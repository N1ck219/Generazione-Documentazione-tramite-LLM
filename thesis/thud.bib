@article{teo_coding_2025,
	title = {{CODING} {REVOLUTION}: {HOW} {AI} {AGENTS} {ARE} {TAKING} {OVER} {SOFTWARE} {REPOSITORY} {MAINTENANCE}},
	volume = {3},
